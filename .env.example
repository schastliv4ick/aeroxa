# --- Qdrant (docker compose up -d qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ru_law

# --- Postgres query log. Comment out to disable logging entirely. ---
DATABASE_URL=postgresql://aeroxa:aeroxa@localhost:5432/aeroxa

# --- LLM: any OpenAI-compatible endpoint ---
# PRODUCTION must be a self-hosted endpoint inside the perimeter (152-ФЗ). Examples:
#   vLLM:   LLM_BASE_URL=http://localhost:8001/v1        LLM_MODEL=Qwen/Qwen3-32B-AWQ
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen3:8b
#
# DEVELOPMENT ONLY — sends text to a third party, never point this at client data:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen3-32b
LLM_TEMPERATURE=0.1

# --- retrieval ---
RETRIEVE_TOP_K=40
RERANK_ENABLED=true
RERANK_TOP_N=6
# Cap on how many chunks of one article may reach the prompt (0 disables the cap).
MAX_PARTS_PER_ARTICLE=2
# Measured, not guessed: across ru/zh/en every question that retrieved the correct
# article scored >= 0.119 and every off-topic one <= 0.007. Deliberately low -- the
# cross-encoder scores Chinese-vs-Russian pairs 4-8x lower than same-script pairs, so a
# threshold picked from Russian examples refuses correct Chinese answers. Provisional;
# recalibrate with a real evaluation set. See docs/SPEC.md section 4.
ABSTAIN_THRESHOLD=0.05
# Optional per-language operating points, e.g. {"zh": 0.03}. Empty by default.
# ABSTAIN_THRESHOLD_BY_LANGUAGE={}

# --- service ---
LOG_LEVEL=INFO
# API_KEY=change-me      # when set, clients must send X-API-Key
# MODELS_EAGER_LOAD=true # load weights at startup instead of on first request

# --- model cache ---
# BGE-M3 and the reranker together need ~9 GB. Set HF_HOME as a real shell environment
# variable (not just here) if your system drive is short on space:
#   PowerShell:  $env:HF_HOME = "D:\hf-cache"
#   bash:        export HF_HOME=/d/hf-cache
